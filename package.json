{
  "name": "@kanera/docx2pdf",
  "version": "1.0.0",
  "description": "Standalone DOCX to PDF renderer in TypeScript. Runs in Node and the browser; no LibreOffice, no native binaries.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "default": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "bin": {
    "docx2pdf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/util/pako.ts src/image/jpeg-codec.ts src/pdf/svg.ts --bundle --format=esm --platform=browser --target=es2022 --minify --sourcemap --sources-content=false --define:Buffer.from=Uint8Array.from --outbase=src --outdir=dist",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json",
    "test": "vitest run",
    "render": "tsx scripts/render.ts",
    "corpus": "tsx scripts/corpus.ts",
    "demo": "tsx scripts/build-demo.ts",
    "demo:serve": "tsx scripts/build-demo.ts --serve"
  },
  "devDependencies": {
    "@fontsource/geist-sans": "5.2.5",
    "@fontsource/instrument-serif": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "jpeg-js": "0.4.4",
    "pako": "3.0.3",
    "pdfjs-dist": "6.4.299",
    "svgpath": "2.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happendev/kanera-docx.git"
  }
}
